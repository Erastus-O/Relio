DATABASE_URL=postgresql://relio:relio@localhost:5432/relio
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
# Where uploaded photos and documents are stored in development. Use S3 or similar in production.
UPLOAD_DIR=./uploads
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Admins can open booking evidence once a dispute has been open this many days
DISPUTE_EVIDENCE_DAYS=5
